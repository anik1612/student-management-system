# PostgreSQL connection string.
# Matches the credentials in docker-compose.yml (host port 5433 avoids clashing with a local Postgres on 5432).
DATABASE_URL="postgresql://sms:sms_local_password@localhost:5433/sms?schema=public"

# Secret used to sign session JWTs (HS256). Generate one with: openssl rand -base64 32
# Must be at least 32 characters.
AUTH_SECRET="replace-me-with-a-32-char-or-longer-random-string"

# Where uploaded assessment files are written. Relative paths resolve from the project root.
# Kept outside /public so files are only reachable through the authorised download route.
UPLOAD_DIR="storage/submissions"
