// Student Management System — Registry module
//
// Modelling notes for the reviewer:
//  * Money is always Decimal(12,2). Never Float — a fee ledger cannot tolerate binary rounding.
//  * Balances are derived (billed − paid), never stored. A denormalised balance column is the
//    classic source of "the system says she owes £0 but finance says £450" support tickets.
//  * Anything a registrar could be asked to justify later (status change, fee override, published
//    result, overridden arrears hold) writes an AuditLog row.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

// Prisma 7: the connection URL lives in prisma.config.ts (CLI) and is passed to the
// PrismaClient constructor via a driver adapter at runtime — see src/lib/db.ts.
datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Role {
  STAFF
  STUDENT
}

enum EnrolmentStatus {
  ENROLLED
  DEFERRED
  WITHDRAWN
  COMPLETED
}

enum FeeType {
  TUITION
  REGISTRATION
  RESIT
  LATE_PENALTY
}

enum PaymentMethod {
  BANK_TRANSFER
  CARD
  CASH
  CHEQUE
}

enum Classification {
  FAIL
  PASS
  MERIT
  DISTINCTION
}

// ---------------------------------------------------------------------------
// Identity
// ---------------------------------------------------------------------------

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         Role
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // A STUDENT user is linked 1:1 to a student record. STAFF users have none.
  student Student?

  auditLogs         AuditLog[]
  feesCreated       FeeAssignment[] @relation("FeeCreatedBy")
  paymentsRecorded  Payment[]       @relation("PaymentRecordedBy")
  assessmentsOwned  Assessment[]    @relation("AssessmentCreatedBy")
  gradesEntered     Grade[]         @relation("GradeEnteredBy")

  @@index([role])
}

// ---------------------------------------------------------------------------
// Academic structure
// ---------------------------------------------------------------------------

model Programme {
  id               String   @id @default(cuid())
  code             String   @unique // e.g. "BSC-CS"
  name             String
  level            String // "Undergraduate" | "Postgraduate"
  durationYears    Int
  // Standard annual tuition for this programme. Copied onto the fee line at assignment time so a
  // later price change never silently rewrites what an existing cohort was billed.
  defaultFeeAmount Decimal  @db.Decimal(12, 2)
  currency         String   @default("GBP")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  students Student[]
  modules  Module[]
}

model Module {
  id          String   @id @default(cuid())
  code        String   @unique // e.g. "CS101"
  title       String
  credits     Int      @default(20)
  programmeId String
  programme   Programme @relation(fields: [programmeId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  assessments Assessment[]

  @@index([programmeId])
}

// ---------------------------------------------------------------------------
// Students
// ---------------------------------------------------------------------------

model Student {
  id        String @id @default(cuid())
  // Human-facing registry reference, e.g. SMS-2026-0001. Allocated atomically (see StudentIdCounter).
  studentId String @unique

  firstName   String
  lastName    String
  email       String   @unique // always stored lower-cased so "A@x.com" cannot duplicate "a@x.com"
  dateOfBirth DateTime @db.Date

  programmeId String
  programme   Programme @relation(fields: [programmeId], references: [id])

  academicYear String // session label, e.g. "2025/26"
  yearOfStudy  Int     @default(1)

  status          EnrolmentStatus @default(ENROLLED)
  statusChangedAt DateTime        @default(now())
  // Registry always wants to know *why* someone left; enforced in the service layer for WITHDRAWN.
  statusReason    String?

  enrolledOn DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // Optional login for the student portal.
  userId String? @unique
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  fees        FeeAssignment[]
  submissions Submission[]
  grades      Grade[]

  @@index([status, programmeId])
  @@index([lastName])
  @@index([programmeId])
}

// Allocates the sequential part of SMS-<year>-<seq>.
// Updated with a single atomic upsert-and-increment statement so two concurrent enrolments can
// never be handed the same number (which `count() + 1` would happily do).
model StudentIdCounter {
  year    Int @id
  lastSeq Int @default(0)
}

// ---------------------------------------------------------------------------
// Fees & payments
// ---------------------------------------------------------------------------

model FeeAssignment {
  id        String @id @default(cuid())
  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  type         FeeType  @default(TUITION)
  amount       Decimal  @db.Decimal(12, 2)
  currency     String   @default("GBP")
  academicYear String
  dueDate      DateTime @db.Date
  description  String?
  // Set when staff bill something other than the programme default — kept for audit.
  overrideNote String?

  createdById String?
  createdBy   User?   @relation("FeeCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  payments Payment[]

  // One tuition line per student per session: blocks accidental double-billing at the DB level.
  @@unique([studentId, academicYear, type])
  @@index([dueDate])
  @@index([studentId])
}

model Payment {
  id              String        @id @default(cuid())
  feeAssignmentId String
  feeAssignment   FeeAssignment @relation(fields: [feeAssignmentId], references: [id], onDelete: Cascade)

  amount    Decimal       @db.Decimal(12, 2)
  paidOn    DateTime      @db.Date
  // Bank/receipt reference. Globally unique so re-keying the same receipt twice is rejected
  // rather than silently clearing a balance that was never actually paid.
  reference String        @unique
  method    PaymentMethod @default(BANK_TRANSFER)
  note      String?

  recordedById String?
  recordedBy   User?   @relation("PaymentRecordedBy", fields: [recordedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([feeAssignmentId])
  @@index([paidOn])
}

// ---------------------------------------------------------------------------
// Assessments & submissions
// ---------------------------------------------------------------------------

model Assessment {
  id       String @id @default(cuid())
  title    String
  moduleId String
  module   Module @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  dueAt       DateTime
  maxScore    Int      @default(100)
  weighting   Int      @default(100) // percent of the module mark
  description String?

  createdById String?
  createdBy   User?   @relation("AssessmentCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  submissions Submission[]
  grades      Grade[]

  @@index([moduleId])
  @@index([dueAt])
}

model Submission {
  id           String     @id @default(cuid())
  assessmentId String
  assessment   Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  studentId    String
  student      Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)

  // Current (latest) file. Superseded uploads live on in SubmissionFile.
  version     Int      @default(1)
  fileName    String // original name, shown to humans
  storedName  String // uuid on disk, never derived from user input
  mimeType    String
  sizeBytes   Int
  submittedAt DateTime @default(now())
  // Frozen at submission time. Recomputing it later would silently absolve late work if a
  // registrar ever extends the deadline.
  isLate      Boolean  @default(false)

  files SubmissionFile[]

  // One submission record per student per assessment; resubmission versions the same row.
  @@unique([assessmentId, studentId])
  @@index([assessmentId])
  @@index([studentId])
}

// Immutable history of every uploaded version — answers "what did she actually have in by the deadline?"
model SubmissionFile {
  id           String     @id @default(cuid())
  submissionId String
  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  version     Int
  fileName    String
  storedName  String
  mimeType    String
  sizeBytes   Int
  submittedAt DateTime @default(now())
  isLate      Boolean  @default(false)

  @@unique([submissionId, version])
}

// ---------------------------------------------------------------------------
// Marksheet
// ---------------------------------------------------------------------------

model Grade {
  id           String     @id @default(cuid())
  assessmentId String
  assessment   Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  studentId    String
  student      Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)

  // Null when the student is recorded absent — an absence is not the same fact as a mark of 0,
  // even though both fail. Boards treat them differently (resit vs. re-take).
  score          Int?
  isAbsent       Boolean         @default(false)
  classification Classification?
  feedback       String?

  // Results are staff-only until explicitly released.
  published   Boolean   @default(false)
  publishedAt DateTime?
  // Why a mark exists but is being held back, e.g. "withheld pending fee settlement".
  withheldReason String?

  enteredById String?
  enteredBy   User?   @relation("GradeEnteredBy", fields: [enteredById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([assessmentId, studentId])
  @@index([studentId, published])
  @@index([assessmentId])
}

// ---------------------------------------------------------------------------
// Audit
// ---------------------------------------------------------------------------

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action     String // e.g. "student.status_changed", "grade.published"
  entityType String
  entityId   String
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
}
