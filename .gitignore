# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — never commit credentials, but the example file is committed on purpose
.env*
!.env.example

# generated Prisma client (regenerated by `npx prisma generate`)
/src/generated

# uploaded assessment files (local disk storage)
/storage

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
